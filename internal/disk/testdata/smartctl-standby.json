{
  "json_format_version": [1, 0],
  "smartctl": {
    "version": [7, 5],
    "argv": ["smartctl", "-j", "-i", "-H", "-A", "-n", "standby", "--", "/dev/sda"],
    "messages": [{"string": "Device is in STANDBY mode, exit(2)", "severity": "information"}],
    "exit_status": 2
